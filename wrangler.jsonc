{
  // Cloudflare Worker config. This is the "where does our backend run" file.
  // `name` is the Worker's name on Cloudflare; `main` is our entry file.
  "name": "whatsapp-agent",
  "main": "src/index.ts",

  // compatibility_date pins which version of the Workers runtime behaviour we
  // get. It makes deploys reproducible: the runtime won't silently change
  // under us. Bump it deliberately, never by accident.
  "compatibility_date": "2025-07-18",

  // Observability = Cloudflare keeps logs we can view. Cheap insurance for a
  // bot that talks to real customers; we'll want to see what it said.
  "observability": {
    "enabled": true
  },

  // KV store for per-parent conversation memory (short history + TTL).
  "kv_namespaces": [
    { "binding": "CONVERSATIONS", "id": "9dc4b75450bb4df48d1e970c6eab658d" }
  ]
}
