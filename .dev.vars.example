# Copy this file to `.dev.vars` (git-ignored) and fill in real values for local
# dev. In production these are set with `wrangler secret put <NAME>` instead.

# API key from https://console.groq.com (Groq is our LLM host for early phases).
GROQ_API_KEY=your_groq_api_key_here

# Which provider + model to use. Provider defaults to "groq" if unset.
# Verify the current model id in Groq's console if the default stops working.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Speech-to-text model for voice notes (Groq Whisper). Optional.
STT_MODEL=whisper-large-v3

# Google service account (for writing leads to Sheets). From the downloaded
# service-account JSON: "client_email" and "private_key". Keep the private key
# on ONE line with newlines escaped as \n (see README setup).
GOOGLE_CLIENT_EMAIL=bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...your...key...\n-----END PRIVATE KEY-----\n"

# WhatsApp (Meta Cloud API).
# VERIFY_TOKEN is any random string YOU choose; you type the same value into the
# Meta webhook setup. TOKEN is the Graph API access token from your Meta app.
WHATSAPP_VERIFY_TOKEN=choose_any_random_string
WHATSAPP_TOKEN=your_meta_graph_api_access_token
# App secret from Meta app settings — used to verify inbound webhook signatures.
WHATSAPP_APP_SECRET=your_meta_app_secret
GRAPH_API_VERSION=v21.0

# Resend (owner booking alerts by email). Key from resend.com. In test mode the
# From defaults to onboarding@resend.dev and can only email your Resend account
# address; verify a domain to send to anyone.
RESEND_API_KEY=your_resend_api_key
ALERT_FROM_EMAIL=onboarding@resend.dev

# Google OAuth for dashboard sign-in. The CLIENT_ID is public and lives in
# wrangler.jsonc (vars); only the SECRET is here / a Worker secret.
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Razorpay payment links (test mode). Keys from dashboard.razorpay.com; the
# webhook secret is what you set when adding the /webhook/razorpay webhook.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Enables POST /debug/ask and /debug/lead for local testing. Leave OUT in production.
ENABLE_DEBUG_ROUTES=true
